# Copy to .env.production and replace every placeholder before deployment.
DEVENGLISH_ENV=production
DEVENGLISH_DOMAIN=english.example.com
DEVENGLISH_PUBLIC_ORIGIN=https://english.example.com
DEVENGLISH_TLS_EMAIL=ops@example.com
DEVENGLISH_ALLOWED_ORIGINS=https://english.example.com
PORT=8080

POSTGRES_DB=devenglish
POSTGRES_USER=devenglish
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://devenglish:URL_ENCODED_PASSWORD@postgres:5432/devenglish?sslmode=disable

DEVENGLISH_AUTH_SECRET=replace-with-at-least-32-random-characters
DEVENGLISH_LOGIN_SECRET=replace-with-at-least-16-random-characters
DEVENGLISH_SECRET_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_SMART_MODEL=deepseek-v4-pro
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_STT_BASE_URL=
AZURE_SPEECH_TTS_BASE_URL=
AZURE_TTS_VOICE=en-US-JennyNeural

# Optional: enables authenticated private GitHub imports.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
