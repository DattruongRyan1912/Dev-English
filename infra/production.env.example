# Copy to .env.production and replace every CHANGE_ME marker before deployment.
# The unchanged file must be rejected by production startup validation.
DEVENGLISH_ENV=production
DEVENGLISH_MODULES=all
DEVENGLISH_DOMAIN=english.example.com
DEVENGLISH_PUBLIC_ORIGIN=https://english.example.com
DEVENGLISH_WORKSPACE_SHELL=new
DEVENGLISH_TLS_EMAIL=ops@example.com
DEVENGLISH_ALLOWED_ORIGINS=https://english.example.com
PORT=8080

POSTGRES_DB=devenglish
POSTGRES_USER=devenglish
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://devenglish:CHANGE_ME@postgres:5432/devenglish?sslmode=disable

DEVENGLISH_AUTH_SECRET=CHANGE_ME
DEVENGLISH_LOGIN_SECRET=CHANGE_ME
DEVENGLISH_SECRET_ENCRYPTION_KEY=CHANGE_ME

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_SMART_MODEL=deepseek-v4-pro
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_STT_BASE_URL=
AZURE_SPEECH_TTS_BASE_URL=
AZURE_TTS_VOICE=en-US-JennyNeural

# Google Drive is read-only in V1. Configure either a short-lived access token
# for a bounded smoke, or all OAuth values for automatic token refresh.
GOOGLE_DRIVE_API_BASE_URL=https://www.googleapis.com/drive/v3
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Local/private embedding sidecar used for 384-dimensional hybrid retrieval.
EMBEDDING_SIDECAR_URL=http://embedding:8090
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# Optional: enables authenticated private GitHub imports.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
